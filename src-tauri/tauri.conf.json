{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delta Desktop",
  "version": "0.1.2",
  "identifier": "dev.delta.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Delta",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
